# Copy to deploy/.env on the VPS (never commit it). Every value below is required unless marked optional.

# Image tag to run; the deploy workflow sets this to the commit SHA.
IMAGE_TAG=latest
# GitHub owner the images are published under (ghcr.io/<owner>/skillcert-*).
GHCR_OWNER=brad82

# Public hostname. Caddy obtains its HTTPS certificate for it; DNS must point at this VPS.
SITE_ADDRESS=skillcert.example.com

# Org timezone for the nightly job and displayed dates.
TZ=America/Denver

POSTGRES_PASSWORD=change-me-long-random

# Demo data: accounts (admin@skillcert.test, candidate01@skillcert.test, …, all using DEMO_PASSWORD), the AFA list, groups and review history.
SEED_DEMO_DATA=true
DEMO_PASSWORD=change-me-12-chars-min

# DigitalOcean Spaces (S3 API) for archived training-record PDFs. Optional until Phase 3.
S3_SERVICE_URL=https://tor1.digitaloceanspaces.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=skillcert-demo
