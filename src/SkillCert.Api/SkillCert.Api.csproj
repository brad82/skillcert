<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Write the OpenAPI document on build; the web app generates its typed client from it. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../web/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name skillcert</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SkillCert.Infrastructure\SkillCert.Infrastructure.csproj" />
    <ProjectReference Include="..\SkillCert.Domain\SkillCert.Domain.csproj" />
    <ProjectReference Include="..\SkillCert.ServiceDefaults\SkillCert.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
