{
  "openapi": "3.1.1",
  "info": {
    "title": "SkillCert.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "Logout",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "CurrentUser"
        ],
        "operationId": "GetCurrentUser",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/api/me/lists": {
      "get": {
        "tags": [
          "MyRecord"
        ],
        "operationId": "GetMyLists",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyListsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CurrencyDto": {
        "required": [
          "status",
          "reason",
          "achievedAt",
          "expiresAt",
          "expiringSoon",
          "hasPendingReview"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CurrencyStatus"
          },
          "reason": {
            "$ref": "#/components/schemas/CurrencyReason"
          },
          "achievedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "expiresAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "expiringSoon": {
            "type": "boolean"
          },
          "hasPendingReview": {
            "type": "boolean"
          }
        }
      },
      "CurrencyReason": {
        "enum": [
          "NeverReviewed",
          "Current",
          "RecertificationExpired",
          "RevisionInvalidated",
          "NotCompetent"
        ]
      },
      "CurrencyStatus": {
        "enum": [
          "NotCertified",
          "Current",
          "Expired",
          "NotCompetent"
        ]
      },
      "CurrentUserResponse": {
        "required": [
          "id",
          "displayName",
          "email",
          "capabilities"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ListNodeKind": {
        "enum": [
          "Heading",
          "Competency"
        ]
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "MyCompetencySummaryDto": {
        "required": [
          "competencyId",
          "code",
          "title",
          "shortTitle",
          "currency",
          "lowestReviewer"
        ],
        "type": "object",
        "properties": {
          "competencyId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "shortTitle": {
            "type": "string"
          },
          "currency": {
            "$ref": "#/components/schemas/CurrencyDto"
          },
          "lowestReviewer": {
            "$ref": "#/components/schemas/ReviewLevelDto"
          }
        }
      },
      "MyListCountsDto": {
        "required": [
          "total",
          "current",
          "expiringSoon",
          "expired",
          "notCompetent",
          "notCertified",
          "pending"
        ],
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "current": {
            "type": "integer",
            "format": "int32"
          },
          "expiringSoon": {
            "type": "integer",
            "format": "int32"
          },
          "expired": {
            "type": "integer",
            "format": "int32"
          },
          "notCompetent": {
            "type": "integer",
            "format": "int32"
          },
          "notCertified": {
            "type": "integer",
            "format": "int32"
          },
          "pending": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "MyListDto": {
        "required": [
          "id",
          "title",
          "isCompliant",
          "counts",
          "nodes"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "isCompliant": {
            "type": "boolean"
          },
          "counts": {
            "$ref": "#/components/schemas/MyListCountsDto"
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MyListNodeDto"
            }
          }
        }
      },
      "MyListNodeDto": {
        "required": [
          "id",
          "parentNodeId",
          "depth",
          "kind",
          "headingCode",
          "headingTitle",
          "competency"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "parentNodeId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "depth": {
            "type": "integer",
            "format": "int32"
          },
          "kind": {
            "$ref": "#/components/schemas/ListNodeKind"
          },
          "headingCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "headingTitle": {
            "type": [
              "null",
              "string"
            ]
          },
          "competency": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MyCompetencySummaryDto"
              }
            ]
          }
        }
      },
      "MyListsResponse": {
        "required": [
          "asOf",
          "lists"
        ],
        "type": "object",
        "properties": {
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "lists": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MyListDto"
            }
          }
        }
      },
      "ReviewLevelDto": {
        "required": [
          "method",
          "classificationCode",
          "order"
        ],
        "type": "object",
        "properties": {
          "method": {
            "$ref": "#/components/schemas/ReviewMethod"
          },
          "classificationCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "order": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ReviewMethod": {
        "enum": [
          "Self",
          "Peer",
          "Classified"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "CurrentUser"
    },
    {
      "name": "MyRecord"
    }
  ]
}